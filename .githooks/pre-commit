#!/bin/sh
set -eu
cd "$(git rev-parse --show-toplevel)"
node scripts/audit-publication.mjs --staged
if ! command -v gitleaks >/dev/null 2>&1; then
  echo '[FINANCE] BLOCKED: Gitleaksが未インストールです。brew install gitleaks を実行してください。' >&2
  exit 1
fi
gitleaks git --pre-commit --staged --redact --no-banner .
